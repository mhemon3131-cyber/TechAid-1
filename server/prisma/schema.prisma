datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("123456")
  role      String   @default("CUSTOMER")
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())

  technician                  Technician?
  serviceRequests             ServiceRequest[] @relation("CustomerRequests")
  serviceRequestsAsTechnician ServiceRequest[] @relation("TechnicianRequests")
  appointments                Appointment[]    @relation("CustomerAppointments")
  notifications               Notification[]
  conversationsAsCustomer     Conversation[]   @relation("CustomerConversations")
  conversationsAsTechnician   Conversation[]   @relation("TechnicianConversations")
  messages                    Message[]
}

model Technician {
  id                   String  @id @default(uuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  specialty            String
  rating               Float   @default(4.9)
  distanceKm           Float   @default(2.1)
  isAvailable          Boolean @default(true)
  avatar               String?
  availableDays        String  @default("Mon,Tue,Wed,Thu,Fri")
  workingHours         String  @default("09:00 AM - 06:00 PM")
  serviceAreas         String  @default("Gulshan, Banani, Dhanmondi, Uttara")
  maxDailyAppointments Int     @default(5)

  appointments Appointment[]
  reviews      Review[]
}

model ServiceRequest {
  id             String @id @default(uuid())
  trackingId     String @unique
  customerId     String
  customer       User   @relation("CustomerRequests", fields: [customerId], references: [id])

  technicianId String?
  technician   User?   @relation("TechnicianRequests", fields: [technicianId], references: [id])

  deviceCategory String
  title          String
  description    String
  urgency        String
  serviceMethod  String
  status         String @default("PENDING")
  estimatedCost  String @default("৳800 - 1,500")

  attachments Attachment[]
  appointment Appointment?
  statusLogs  StatusHistory[]
  review      Review?
  conversation Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model StatusHistory {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status           String
  note             String?
  createdAt        DateTime       @default(now())
}

model Attachment {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fileUrl          String
  fileType         String
  fileName         String
  createdAt        DateTime       @default(now())
}

model Appointment {
  id               String          @id @default(uuid())
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  customerId String
  customer   User   @relation("CustomerAppointments", fields: [customerId], references: [id])

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  date          String
  timeSlot      String
  serviceType   String
  status        String @default("PENDING")
  estimatedCost String @default("৳800 - 1,500")

  createdAt DateTime @default(now())
}

model TechnicianLocation {
  id           String   @id @default(uuid())
  technicianId String   @unique
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceRequestLocation {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  latitude         Float
  longitude        Float
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TechnicianAssignment {
  id String @id @default(uuid())

  serviceRequestId String
  technicianId     String

  expertiseScore    Float
  availabilityScore Float
  proximityScore    Float
  ratingScore       Float
  workloadScore     Float
  totalScore        Float

  distanceKm Float?

  assignedDate     String?
  assignedTimeSlot String?

  attempt Int @default(1)

  status String @default("PENDING_CUSTOMER_APPROVAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceRequestId, attempt])
  @@index([serviceRequestId])
  @@index([technicianId])
}

model TechnicianPricing {
  id           String @id @default(uuid())
  technicianId String @unique

  liveChatFee  Float @default(500)
  videoCallFee Float @default(700)
  homeVisitFee Float @default(1200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
}

model Review {
  id String @id @default(uuid())

  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  rating Int

  serviceQuality  Int
  professionalism Int
  communication   Int
  responseTime    Int

  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
}

model Payment {
  id String @id @default(uuid())

  customerId       String
  technicianId     String
  serviceRequestId String

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  serviceTitle  String
  serviceMethod String

  amount   Float
  currency String @default("bdt")

  status String @default("PENDING")

  invoiceNumber String @unique

  paymentMethod String @default("STRIPE_TEST")

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([technicianId])
  @@index([serviceRequestId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  customerId       String
  technicianId     String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  customer       User           @relation("CustomerConversations", fields: [customerId], references: [id])
  technician     User           @relation("TechnicianConversations", fields: [technicianId], references: [id])

  messages     Message[]
  callSessions CallSession[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CallSession {
  id             String    @id @default(uuid())
  conversationId String
  roomName       String
  callType       String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}