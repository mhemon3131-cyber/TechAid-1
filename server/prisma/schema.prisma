datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("123456")
  role      String   @default("CUSTOMER") // CUSTOMER, TECHNICIAN, ADMIN
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())

  technician                  Technician?
  serviceRequests             ServiceRequest[] @relation("CustomerRequests")
  serviceRequestsAsTechnician ServiceRequest[] @relation("TechnicianRequests")
  appointments                Appointment[]    @relation("CustomerAppointments")
  notifications               Notification[]
  conversationsAsCustomer     Conversation[]   @relation("CustomerConversations")
  conversationsAsTechnician   Conversation[]   @relation("TechnicianConversations")
  messages                    Message[]
}

model Technician {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  specialty            String // e.g. Laptop & Desktop Specialist
  rating               Float         @default(4.9)
  distanceKm           Float         @default(2.1)
  isAvailable          Boolean       @default(true)
  avatar               String?
  availableDays        String        @default("Mon,Tue,Wed,Thu,Fri")
  workingHours         String        @default("09:00 AM - 06:00 PM")
  serviceAreas         String        @default("Gulshan, Banani, Dhanmondi, Uttara")
  maxDailyAppointments Int           @default(5)
  appointments         Appointment[]

  // Module 1 Feature 4 - ADD ONLY
  assignments TechnicianAssignment[]
}

model ServiceRequest {
  id             String          @id @default(uuid())
  trackingId     String          @unique // e.g. REQ-2026-8942
  customerId     String
  customer       User            @relation("CustomerRequests", fields: [customerId], references: [id])
  technicianId   String?
  technician     User?           @relation("TechnicianRequests", fields: [technicianId], references: [id])
  deviceCategory String // Laptop, Desktop, Phone, Printer, Internet
  title          String
  description    String
  urgency        String // Low, Moderate, Critical
  serviceMethod  String // Live Chat, Video Call, Home Visit
  status         String          @default("PENDING") // PENDING, ASSIGNED, ACCEPTED, IN_PROGRESS, ON_THE_WAY, COMPLETED
  estimatedCost  String          @default("৳800 - 1,500")
  attachments    Attachment[]
  appointment    Appointment?
  statusLogs     StatusHistory[]
  conversation   Conversation?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  // Module 1 Feature 4 - ADD ONLY
  assignments TechnicianAssignment[]
}

model StatusHistory {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status           String // PENDING, ASSIGNED, ACCEPTED, IN_PROGRESS, ON_THE_WAY, COMPLETED
  note             String?
  createdAt        DateTime       @default(now())
}

model Attachment {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fileUrl          String
  fileType         String // IMAGE, SCREENSHOT, VOICE, VIDEO
  fileName         String
  createdAt        DateTime       @default(now())
}

model Appointment {
  id               String          @id @default(uuid())
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  customerId       String
  customer         User            @relation("CustomerAppointments", fields: [customerId], references: [id])
  technicianId     String
  technician       Technician      @relation(fields: [technicianId], references: [id])
  date             String // e.g. Mon Jul 13, 2026
  timeSlot         String // e.g. 10:00 am, 11:30 am
  serviceType      String // Remote support, Home visit, Service center
  status           String          @default("PENDING") // PENDING, APPROVED, REJECTED, RESCHEDULED
  estimatedCost    String          @default("৳800 - 1,500")
  createdAt        DateTime        @default(now())
}

// ==========================================================
// MODULE 1 - FEATURE 4
// AUTOMATIC TECHNICIAN ASSIGNMENT ENGINE
// ADD ONLY
// ==========================================================

model TechnicianAssignment {
  id String @id @default(uuid())

  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  status String @default("PENDING_CUSTOMER_APPROVAL")

  totalScore        Float
  expertiseScore    Float
  availabilityScore Float
  workloadScore     Float
  ratingScore       Float

  workloadCount        Int @default(0)
  maxDailyAppointments Int @default(5)

  matchReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceRequestId, createdAt])
  @@index([technicianId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // e.g. REQUEST_ACCEPTED, EMERGENCY_ALERT, APPOINTMENT_REMINDER
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  customerId       String
  technicianId     String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  customer       User           @relation("CustomerConversations", fields: [customerId], references: [id])
  technician     User           @relation("TechnicianConversations", fields: [technicianId], references: [id])
  messages       Message[]
  callSessions   CallSession[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CallSession {
  id             String    @id @default(uuid())
  conversationId String
  roomName       String
  callType       String // VOICE, VIDEO
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
